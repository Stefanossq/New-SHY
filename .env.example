# Chave da API Gemini (https://aistudio.google.com/apikey).
# Sem ela o gerador continua funcionando, mas usa dados de exemplo.
GEMINI_API_KEY=

# Opcional: modelos (padrão em shared/config.ts)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Opcional: gerar imagens dos produtos com IA (custa mais cota). 1 = sim
GENERATE_IMAGES=1

PORT=3000
