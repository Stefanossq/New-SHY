{
  "name": "scaffold-engine-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env server.ts",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx --env-file-if-exists=.env server.ts",
    "test": "vitest run",
    "tauri": "tauri",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.18.0",
    "motion": "^12.40.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
